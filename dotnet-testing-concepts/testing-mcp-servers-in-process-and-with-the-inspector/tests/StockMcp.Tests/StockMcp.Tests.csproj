<!-- MSTest.Sdk brings MSTest, its analyzers and the Microsoft.Testing.Platform runner; global.json next to the
     solution makes `dotnet test` use that runner. -->
<Project Sdk="MSTest.Sdk/4.5.3">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\StockMcp\StockMcp.csproj" />
  </ItemGroup>

</Project>
