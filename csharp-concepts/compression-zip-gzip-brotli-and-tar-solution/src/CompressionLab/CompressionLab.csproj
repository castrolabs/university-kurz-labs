<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The net11.0 target (Zstandard bonus) only appears when the .NET 11 SDK is installed. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
